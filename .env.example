# 로컬 PostgreSQL (docker-compose.yml 기본값과 동일)
WIO_DB_URL=jdbc:postgresql://localhost:5432/when_i_off
WIO_DB_USER=wio
WIO_DB_PASSWORD=wio

# 앱/데스크탑이 X-Api-Token 헤더로 보내는 고정 토큰 (1인 사용)
WIO_API_TOKEN=change-me

# 공공데이터포털(data.go.kr) KLID 전국통합데이터 서비스 키 — 반드시 "Decoding" 키를 넣는다
REALTIME_BUS_API_KEY=your-decoded-service-key
TRAFFIC_SIGNAL_API_KEY=your-decoded-service-key
