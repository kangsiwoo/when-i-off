// cp Secrets.example.xcconfig Secrets.xcconfig 후 값을 채운다. Secrets.xcconfig는 커밋하지 않는다(.gitignore).

// Xcode → Settings → Accounts에 로그인한 Apple ID의 팀 ID (10자리). 실기기 설치에만 필요하다.
DEVELOPMENT_TEAM =

// 무료(개인) 팀은 번들 ID가 전 세계에서 유일해야 한다. 이미 쓰인 ID라고 나오면 바꾼다.
// WIO_BUNDLE_ID = com.kangsiwoo.whenioff

// 백엔드 주소. xcconfig는 `//`를 주석으로 읽으므로 `$()`로 끊어 쓴다.
// LAN의 http 주소는 ATS 예외(NSAllowsLocalNetworking)로 허용된다. 그 밖의 서버는 https를 쓴다.
WIO_BASE_URL = http:/$()/192.168.0.10:8080

// Debug 빌드 첫 실행에 Keychain으로 옮겨진다. 비워 두고 앱 설정 화면에서 넣어도 된다.
WIO_API_TOKEN =
