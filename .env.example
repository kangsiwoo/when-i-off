# 로컬 PostgreSQL (docker-compose.yml 기본값과 동일)
WIO_DB_URL=jdbc:postgresql://localhost:5432/when_i_off
WIO_DB_USER=wio
WIO_DB_PASSWORD=wio

# 앱/데스크탑이 X-Api-Token 헤더로 보내는 고정 토큰 (1인 사용)
WIO_API_TOKEN=change-me

# 공공데이터포털(data.go.kr) KLID 전국통합데이터 서비스 키
# "Decoding"/"Encoding" 키 아무거나 가능 — 값에 `%`가 있으면 이미 인코딩된 키로 보고 그대로 보낸다
PRECISE_BUS_API=your-service-key
REALTIME_TREFFIC_LIGHT_API=your-service-key
