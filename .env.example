# 로컬 PostgreSQL. docker-compose.yml이 이 값으로 컨테이너 계정을 만든다(POSTGRES_USER/PASSWORD).
# WIO_DB_PASSWORD는 비어 있으면 compose가 실패한다. 아무 값이나 넣되, 볼륨이 이미 있으면 처음 만든 비밀번호를 그대로 둔다
# (Postgres는 최초 기동 때만 이 값을 읽는다 — 바꾸려면 ALTER USER 또는 볼륨 삭제).
# compose 안의 backend/analytics는 WIO_DB_URL 대신 postgres 서비스 주소를 쓴다 (이 URL은 로컬 bootRun·analytics용).
WIO_DB_URL=jdbc:postgresql://localhost:5432/when_i_off
WIO_DB_USER=wio
WIO_DB_PASSWORD=change-me-db

# 앱/데스크탑이 X-Api-Token 헤더로 보내는 고정 토큰 (1인 사용)
WIO_API_TOKEN=change-me

# 공공데이터포털(data.go.kr) 서비스 키 — 버스는 TAGO, 신호등은 KLID 전국통합데이터
# "Decoding"/"Encoding" 키 아무거나 가능 — 값에 `%`가 있으면 이미 인코딩된 키로 보고 그대로 보낸다
TAGO_BUS_API=your-service-key
REALTIME_TREFFIC_LIGHT_API=your-service-key
